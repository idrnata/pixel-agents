rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-isolated collection hierarchy
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /tasks/{taskId} {
        allow read: if isOwner(userId) && isValidId(taskId);
        allow write: if false; // Server-authoritative via Firebase Admin SDK
      }

      match /taskEvents/{eventId} {
        allow read: if isOwner(userId) && isValidId(eventId);
        allow write: if false; // Server-authoritative via Firebase Admin SDK
      }

      match /agents/{agentId} {
        allow read: if isOwner(userId) && isValidId(agentId);
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId) && isValidId(settingId);
        allow create, update: if isOwner(userId) && isValidId(settingId);
        allow delete: if false;
      }
    }
  }
}
