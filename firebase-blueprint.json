{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "An autonomous AI agent task",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "userId": { "type": "string" },
        "assignedAgentId": { "type": "string", "enum": ["manager", "researcher", "analyst"] },
        "parentTaskId": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "planning", "thinking", "working", "waiting", "completed", "failed"] },
        "createdAt": { "type": "number" },
        "startedAt": { "type": "number" },
        "completedAt": { "type": "number" },
        "currentStep": { "type": "string", "maxLength": 500 },
        "result": { "type": "string", "maxLength": 50000 },
        "error": { "type": "string", "maxLength": 5000 },
        "metadata": { "type": "object" }
      },
      "required": ["id", "title", "userId", "assignedAgentId", "status", "createdAt"]
    },
    "TaskEvent": {
      "title": "TaskEvent",
      "description": "Event logged during task execution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string" },
        "agentId": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "number" },
        "payload": { "type": "object" }
      },
      "required": ["id", "taskId", "userId", "agentId", "type", "timestamp"]
    },
    "Setting": {
      "title": "Setting",
      "description": "User specific office settings and layout",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "layout": { "type": "string", "maxLength": 100000 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User-isolated task documents"
    },
    "/users/{userId}/taskEvents/{eventId}": {
      "schema": { "$ref": "#/entities/TaskEvent" },
      "description": "User-isolated task events"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "User-isolated settings"
    }
  }
}
